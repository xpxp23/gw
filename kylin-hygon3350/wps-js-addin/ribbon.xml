                    <menu id="mnuInsertGWObject" getImage="GetImage" label="公文部件" size="large" screentip="快速插入红头版头、函线、装订线与版记表格">
                        <button id="btnHeadSingle" onAction="OnAction" getImage="GetImage" label="版头：单行发文机关" screentip="插入单行红头发文机关标志与发文字号、红色反线" />
